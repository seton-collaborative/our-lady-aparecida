<!-- ============================================
     TOP BAR
     ============================================ -->
<div class="top-bar">
  <div class="container">
    <div>
{%- if home %}
      <span>{{ contact.street }}, {{ contact.city }}, {{ contact.state }} {{ contact.zip }}</span>
      <span style="margin: 0 8px; opacity: 0.4;">·</span>
      <a href="tel:{{ contact.phone_link }}">{{ contact.phone }}</a>
      <span style="margin: 0 8px; opacity: 0.4;">·</span>
      <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
{%- else %}
      {{ contact.street }}, {{ contact.city }} {{ contact.state }} {{ contact.zip }} &nbsp;·&nbsp;
      <a href="tel:{{ contact.phone_link }}">{{ contact.phone }}</a> &nbsp;·&nbsp;
      <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
{%- endif %}
    </div>
    <div class="top-bar-social">
{%- for s in menu.social %}
      <a href="{{ s.href }}">{{ s.label }}</a>
{%- endfor %}
    </div>
  </div>
</div>
