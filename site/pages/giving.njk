---
permalink: giving.html
styles: giving
content_page: giving
give_direct: true
---
{% extends "layouts/base.njk" %}
{% block main %}
{% set c = parish.pages['giving'] %}
<!-- ============================================
     PAGE HEADER
     ============================================ -->
<header class="page-header">
  <div class="container">
    <p class="page-header-eyebrow">
      <span data-i18n="pt">{{ c.page_header.support_our_parish_s_mission.pt | t }}</span>
      <span data-i18n="en">{{ c.page_header.support_our_parish_s_mission.en | t }}</span>
    </p>
    <h1 class="page-header-title">
      <span data-i18n="pt">{{ c.page_header.online_giving.pt | t }}</span>
      <span data-i18n="en">{{ c.page_header.online_giving.en | t }}</span>
    </h1>
    <div class="gold-rule"></div>
    <p class="page-header-subtitle">
      <span data-i18n="pt">{{ c.page_header.a_safe_and_convenient_way.pt | t }}</span>
      <span data-i18n="en">{{ c.page_header.a_safe_and_convenient_way.en | t }}</span>
    </p>
  </div>
</header>

<!-- ============================================
     PRIMARY CTA
     ============================================ -->
<section class="primary-cta">
  <div class="container">
    <a href="https://osvhub.com/our-lady-of-aparecida-parish/giving/funds" target="_blank" rel="noopener" class="btn btn-gold btn-large">
      <span data-i18n="pt">{{ c.primary_cta.make_a_donation_online.pt | t }}</span>
      <span data-i18n="en">{{ c.primary_cta.make_a_donation_online.en | t }}</span>
    </a>
  </div>
</section>

<!-- ============================================
     GIVING CONTENT
     ============================================ -->
<section class="giving-section">
  <div class="container">
    <div class="giving-grid">

      <!-- LEFT COLUMN -->
      <div class="giving-col-left">

        <div class="giving-block">
          <h2>
            <span data-i18n="pt">{{ c.giving_content.n24_7_accessibility.pt | t }}</span>
            <span data-i18n="en">{{ c.giving_content.n24_7_accessibility.en | t }}</span>
          </h2>
          <p data-i18n-block="pt">{{ c.giving_content.your_online_donation_can_be.pt | t }}</p>
          <p data-i18n-block="en">{{ c.giving_content.your_online_donation_can_be.en | t }}</p>
        </div>

        <div class="giving-block">
          <h2>
            <span data-i18n="pt">{{ c.giving_content.benefits_of_donating_online.pt | t }}</span>
            <span data-i18n="en">{{ c.giving_content.benefits_of_donating_online.en | t }}</span>
          </h2>
          <ul class="benefits-list">
            <li>
              <span data-i18n="pt">{{ c.giving_content.no_need_for_checks_or.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.no_need_for_checks_or.en | t }}</span>
            </li>
            <li>
              <span data-i18n="pt">{{ c.giving_content.n24_7_web_based_access.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.n24_7_web_based_access.en | t }}</span>
            </li>
            <li>
              <span data-i18n="pt">{{ c.giving_content.easily_schedule_recurring_gifts.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.easily_schedule_recurring_gifts.en | t }}</span>
            </li>
            <li>
              <span data-i18n="pt">{{ c.giving_content.your_donation_amount_can_be.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.your_donation_amount_can_be.en | t }}</span>
            </li>
            <li>
              <span data-i18n="pt">{{ c.giving_content.donating_with_a_credit_card.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.donating_with_a_credit_card.en | t }}</span>
            </li>
            <li>
              <span data-i18n="pt">{{ c.giving_content.you_support_your_parish_every.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.you_support_your_parish_every.en | t }}</span>
            </li>
          </ul>
        </div>

        <!-- Decorative statue illustration -->
        <div class="statue-block">
          <div class="statue-illustration" aria-hidden="true">
            <!-- Stylized line-art of Nossa Senhora Aparecida -->
            <svg viewBox="0 0 280 360" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Crown -->
              <path d="M120 25 L130 12 L140 22 L150 8 L160 22 L170 12 L180 25 Z" />
              <circle cx="125" cy="14" r="1.5" fill="currentColor" />
              <circle cx="150" cy="9" r="1.5" fill="currentColor" />
              <circle cx="175" cy="14" r="1.5" fill="currentColor" />
              <!-- Cross atop crown -->
              <line x1="150" y1="8" x2="150" y2="-2" />
              <line x1="146" y1="2" x2="154" y2="2" />
              <!-- Crown band -->
              <line x1="118" y1="28" x2="182" y2="28" />
              <!-- Veil/head outline -->
              <path d="M105 30 Q100 50 105 70 L115 78 L130 80 L150 80 L170 80 L185 78 L195 70 Q200 50 195 30" />
              <!-- Inner face mark -->
              <ellipse cx="150" cy="55" rx="14" ry="22" />
              <!-- Eyes (simple dots) -->
              <circle cx="144" cy="52" r="1" fill="currentColor" />
              <circle cx="156" cy="52" r="1" fill="currentColor" />
              <!-- Mantle outer flowing shape -->
              <path d="M105 70 Q70 130 60 200 Q55 260 70 320 Q90 340 110 345 L150 350 L190 345 Q210 340 230 320 Q245 260 240 200 Q230 130 195 70" />
              <!-- Inner robe shape -->
              <path d="M125 80 Q115 140 115 200 Q115 260 125 320 L150 325 L175 320 Q185 260 185 200 Q185 140 175 80" />
              <!-- Decorative pattern lines on mantle -->
              <path d="M85 130 Q80 170 82 220 Q85 260 90 290" opacity="0.5" />
              <path d="M215 130 Q220 170 218 220 Q215 260 210 290" opacity="0.5" />
              <!-- Hands joined center -->
              <path d="M138 195 Q140 215 145 230 L150 235 L155 230 Q160 215 162 195 Z" />
              <!-- Rosary detail -->
              <circle cx="150" cy="245" r="1.5" fill="currentColor" />
              <line x1="150" y1="247" x2="150" y2="280" stroke-dasharray="2 3" />
              <line x1="146" y1="280" x2="154" y2="280" />
              <line x1="150" y1="276" x2="150" y2="284" />
              <!-- Base -->
              <ellipse cx="150" cy="350" rx="48" ry="6" opacity="0.6" />
            </svg>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN -->
      <div class="giving-col-right">

        <div class="giving-block">
          <h2>
            <span data-i18n="pt">{{ c.giving_content.how_to_begin.pt | t }}</span>
            <span data-i18n="en">{{ c.giving_content.how_to_begin.en | t }}</span>
          </h2>
          <p style="font-style: italic; color: var(--warm-600); font-size: 0.95rem;">
            <span data-i18n="pt">{{ c.giving_content.if_you_need_to_set.pt | t }}</span>
            <span data-i18n="en">{{ c.giving_content.if_you_need_to_set.en | t }}</span>
          </p>
        </div>

        <ol class="steps-list">
          <li class="step-item">
            <div class="step-title">
              <span data-i18n="pt">{{ c.giving_content.create_a_new_account.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.create_a_new_account.en | t }}</span>
            </div>
            <div class="step-body">
              <p data-i18n-block="pt">{{ c.giving_content.click_on_the_make_a.pt | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.click_on_the_make_a.en | t }}</p>
            </div>
          </li>

          <li class="step-item">
            <div class="step-title">
              <span data-i18n="pt">{{ c.giving_content.enter_your_account_information.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.enter_your_account_information.en | t }}</span>
            </div>
            <div class="step-body">
              <p data-i18n-block="pt">{{ c.giving_content.login_information_the_user_id.pt | t }}</p>
              <p data-i18n-block="pt">{{ c.giving_content.personal_and_address_information_the.pt | t }}</p>
              <p data-i18n-block="pt">{{ c.giving_content.security_code_fill_in_the.pt | t }}</p>
              <p data-i18n-block="pt">{{ c.giving_content.click_the_submit_button_an.pt | t }}</p>

              <p data-i18n-block="en">{{ c.giving_content.login_information_the_user_id.en | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.personal_and_address_information_the.en | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.security_code_fill_in_the.en | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.click_the_submit_button_an.en | t }}</p>
            </div>
          </li>

          <li class="step-item">
            <div class="step-title">
              <span data-i18n="pt">{{ c.giving_content.confirm_your_new_account.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.confirm_your_new_account.en | t }}</span>
            </div>
            <div class="step-body">
              <p data-i18n-block="pt">{{ c.giving_content.open_the_email_that_confirms.pt | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.open_the_email_that_confirms.en | t }}</p>
            </div>
          </li>

          <li class="step-item">
            <div class="step-title">
              <span data-i18n="pt">{{ c.giving_content.log_in_to_your_account.pt | t }}</span>
              <span data-i18n="en">{{ c.giving_content.log_in_to_your_account.en | t }}</span>
            </div>
            <div class="step-body">
              <p data-i18n-block="pt">{{ c.giving_content.click_on_sign_in_in.pt | t }}</p>
              <p data-i18n-block="en">{{ c.giving_content.click_on_sign_in_in.en | t }}</p>
            </div>
          </li>
        </ol>

      </div>

    </div>
  </div>
</section>

<!-- ============================================
     FINAL CTA
     ============================================ -->
<section class="final-cta">
  <div class="container">
    <p>
      <span data-i18n="pt">{{ c.final_cta.ready_to_support_our_parish.pt | t }}</span>
      <span data-i18n="en">{{ c.final_cta.ready_to_support_our_parish.en | t }}</span>
    </p>
    <a href="https://osvhub.com/our-lady-of-aparecida-parish/giving/funds" target="_blank" rel="noopener" class="btn btn-gold btn-large">
      <span data-i18n="pt">{{ c.final_cta.make_a_donation_online.pt | t }}</span>
      <span data-i18n="en">{{ c.final_cta.make_a_donation_online.en | t }}</span>
    </a>
    <a href="financial-reports.html" class="final-cta-link">
      <span data-i18n="pt">{{ c.final_cta.financial_reports.pt | t }}</span>
      <span data-i18n="en">{{ c.final_cta.financial_reports.en | t }}</span>
    </a>
  </div>
</section>
{% endblock %}
